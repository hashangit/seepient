  "cards": [
    {
      "dot": "cyan",
      "title": "How a run flows",
      "items": [
        "Your prompt enters through the terminal, the API, or the Worker SDK",
        "The agent loop plans, calls tools, and streams the answer back",
        "Every effect passes the permission engine before anything happens"
      ]
    },
    {
      "dot": "rose",
      "title": "The safety rails",
      "items": [
        "Risky actions park in the approval inbox until a human decides, even across restarts",
        "The secret shield redacts credentials before any model sees them",
        "Every action ends in exactly one audit record"
      ]
    },
    {
      "dot": "emerald",
      "title": "Where state lives",
      "items": [
        "Credentials, sessions, settings, and audit land in stores you can inspect",
        "SDK embedders inject their own stores, so nothing is written behind their back",
        "Shared contracts and quarantined vendor SDKs keep the layers honest"
      ]
    }
  ]
