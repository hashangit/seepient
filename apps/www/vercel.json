{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": { "eq": "www.seepients.com" } }],
      "destination": "https://seepients.com/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": { "eq": "www.seepients.com" } }],
      "destination": "https://seepients.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap-index.xml",
      "statusCode": 301
    }
  ]
}
