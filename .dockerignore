# =============================================================================
# Seepient Docker Ignore — Exclude development-only files from build context
# =============================================================================

# Version control
.git
.gitignore
.github

# Dependencies (rebuilt inside the container)
node_modules

# Build output (rebuilt inside the container)
dist

# Development tools, agent state, and local caches
.agents
.codex
.commandcode
.specify
.pi
.tmp
.seepient
.pnpm-store
.claude
.dual-graph
.qwen
.vscode
.idea
*.swp
*.swo
*~

# Native build cache
native/**/target

# Documentation site source (docs are published separately)
docs

# OS-generated files
.DS_Store
Thumbs.db

# Environment files (sensitive — mount at runtime via --env-file)
.env
.env.*
!.env.example

# Test and CI artifacts
coverage
.nyc_output
test-results
playwright-report

# Docker files themselves (no recursion needed)
Dockerfile
docker-compose.yml
docker-compose*.yml
.dockerignore

# Misc development files
*.log
npm-debug.log*
pnpm-debug.log*
CHANGELOG.md
CONTRIBUTING.md
FEATURES.md
CONTEXT.md


# npm packaging
.npmignore
