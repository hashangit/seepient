# Dependencies
node_modules/
.pnpm-store/

# Per-machine pnpm config (e.g. absolute store-dir). Must never be committed —
# machine-specific paths break CI runners (EACCES on Linux).
.npmrc

# Build output
dist/

# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db
Library/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Tool caches
.dual-graph/
.qwen/
.claude/
.agents/
.zcode/
.codex/
.commandcode/
.specify/
.pi/

# Temporary files
.tmp/
*.visual-check.*

# Logs
*.log
npm-debug.log*

# Coverage
coverage/
docs/.vitepress/cache/
docs/.vitepress/dist/
docs/.vitepress/.temp/

# zFlow agent
.zflow/
.dual-graph-context/

# Local Seepient config (per-user settings, sessions, keys)
.seepient/

# Test media artifacts
generated-*.png
edited-*.png

# spec 019: dev-built native helper binaries (pnpm native:build)
src/native-fs-commit/
native/fs-commit/target/

