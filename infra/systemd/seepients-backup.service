[Unit]
Description=Create and verify a Seepients production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/seepients/backup.env
ExecStart=/usr/local/sbin/seepients-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
