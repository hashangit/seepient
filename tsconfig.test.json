{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "seepient-engine/dist/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "examples/**/*",
    "scripts/**/*",
    "scripts/pack-verify.d.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
